{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seriousvibecoding.dev/schemas/receipts/bounded-exit-v1",
  "title": "Bounded adversarial-review exit adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_kind",
    "wi",
    "candidate_sha",
    "tree_hash",
    "candidate_digest",
    "cycle_id",
    "rounds_run",
    "hard_cap",
    "round_identities",
    "terminal_launcher_receipt_sha256",
    "terminal_findings_sha256",
    "review_log",
    "check_review_round_cap",
    "findings_census",
    "rubric_failure_census"
  ],
  "properties": {
    "certification_failure_census": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "reviewer_family",
          "for_content_sha",
          "finding_ids",
          "disposition",
          "justification",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_family": {
            "type": "string",
            "minLength": 1
          },
          "for_content_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "const": "fixed"
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/artifact"
            }
          }
        }
      }
    },
    "schema_version": { "type": "integer", "const": 1 },
    "review_kind": { "type": "string", "enum": ["plan", "exec"] },
    "wi": { "type": "string", "minLength": 1 },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cycle_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rounds_run": { "type": "integer", "minimum": 1, "maximum": 3 },
    "hard_cap": { "type": "integer", "const": 3 },
    "round_identities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "review_target_digest", "launcher_receipt_sha256", "findings_sha256"],
        "properties": {
          "round": { "type": "integer", "minimum": 1, "maximum": 3 },
          "review_target_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "launcher_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "findings_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "terminal_launcher_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "terminal_findings_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "review_log": { "$ref": "#/definitions/artifact" },
    "check_review_round_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "result_digest"],
      "properties": {
        "exit_code": { "type": "integer", "const": 0 },
        "result_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "findings_census": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "disposition", "justification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "disposition": { "type": "string", "enum": ["fixed", "accept-with-justification", "reject-with-justification"] },
          "justification": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/definitions/artifact" }
          }
        }
      }
    },
    "rubric_failure_census": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rubric_id",
          "finding_ids",
          "disposition",
          "justification",
          "evidence"
        ],
        "properties": {
          "rubric_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "finding_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "disposition": {
            "type": "string",
            "enum": [
              "fixed",
              "accept-with-justification",
              "reject-with-justification"
            ]
          },
          "justification": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/artifact"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
