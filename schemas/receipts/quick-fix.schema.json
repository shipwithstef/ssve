{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "quick-fix receipt",
  "type": "object",
  "required": ["receipt_type", "schema_version", "tree_hash", "eligible", "reasons", "files", "timestamp"],
  "properties": {
    "receipt_type": { "const": "quick-fix" },
    "schema_version": { "type": "integer", "minimum": 1 },
    "tree_hash": { "type": "string", "minLength": 7 },
    "eligible": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" } },
    "added_lines": { "type": "integer", "minimum": 0 },
    "removed_lines": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "git_user": { "type": "string" }
  }
}
