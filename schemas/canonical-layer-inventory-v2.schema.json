{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seriousvibecoding.dev/schemas/canonical-layer-inventory-v2.schema.json",
  "title": "SVC Canonical Layer Inventory v2",
  "type": "object",
  "required": ["schema_version", "generation", "source_digests", "layers", "inventory_digest"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "generation": { "type": "integer", "minimum": 1 },
    "source_digests": {
      "type": "object",
      "required": ["skills", "stages", "concerns", "authorities", "hosts"],
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "source_path", "source_digest", "applicable", "applicability_reason", "unique_benefit", "consumes", "produces"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["SKILL", "STAGE", "CONCERN", "AUTHORITY", "HOST"] },
          "source_path": { "type": "string", "minLength": 1 },
          "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "applicable": { "type": "boolean" },
          "applicability_reason": { "type": "string", "minLength": 1 },
          "unique_benefit": { "type": "string", "minLength": 1 },
          "consumes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "produces": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "inventory_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
