{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seriousvibecoding.dev/schemas/swarm-trust-registry-v1.schema.json",
  "title": "SVC Swarm Trust Registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "keys",
    "registry_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "root_keyid": {
      "type": "string"
    },
    "root_signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "keyid",
          "purpose",
          "principal_id",
          "public_key",
          "valid_from"
        ],
        "additionalProperties": false,
        "properties": {
          "keyid": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "enum": [
              "coordinate",
              "submit",
              "verify"
            ]
          },
          "principal_id": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "session_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_key": {
            "type": "string",
            "minLength": 1
          },
          "allowed_receipt_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "submission_receipt",
                "acceptance_receipt",
                "rejection_receipt",
                "synchronization_receipt",
                "resolution_receipt",
                "checkpoint_receipt"
              ]
            }
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "revoked_at_sequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "allowed_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "register",
                "acquire",
                "heartbeat",
                "progress",
                "submit",
                "cancel",
                "resolve",
                "handoff",
                "ack"
              ]
            },
            "default": []
          }
        }
      }
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
