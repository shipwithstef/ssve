{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SVC product-safe implementation plan contract",
  "type": "object",
  "required": ["schema_version", "manifest", "ownership", "resource_review", "resource_writers", "claims", "executables"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest": { "type": "string" },
    "base_sha": { "type": "string", "minLength": 1 },
    "ownership": { "type": "array" },
    "resource_review": {
      "type": "object",
      "required": ["verification", "denominator", "disposition", "evidence"],
      "properties": {
        "verification": { "const": "changed-executable-census" },
        "denominator": { "type": "integer", "minimum": 0 },
        "disposition": { "enum": ["no-risky-resource-writers", "declared-risky-resource-writers"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "resource_writers": { "type": "array" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "evidence", "denominator"],
        "properties": {
          "kind": { "enum": ["absence", "complete", "all", "unused"] },
          "denominator": { "type": "integer", "minimum": 0 },
          "evidence": {
            "type": "object",
            "required": ["artifact", "verification"],
            "properties": {
              "artifact": { "type": "string", "minLength": 1 },
              "verification": { "enum": ["source-ledger-count", "triage-direct-proposals", "diff-manifest-parity", "executable-consumers"] }
            }
          }
        }
      }
    },
    "executables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "consumers"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "consumers": {
            "type": "array", "minItems": 1,
            "items": { "type": "object", "required": ["path", "query"], "properties": { "path": { "type": "string", "minLength": 1 }, "query": { "type": "string", "minLength": 1 } } }
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "description": "WI-553 AC-553-1/3: declared subset of the shared risk-flag table (scripts/lib/risk-flags.mjs). Presence of a flag here REQUIRES its matching section below; absence of a flag REQUIRES its matching section to be absent — the contract grows only matched sections.",
      "items": { "enum": ["runtime_concurrency", "external_state_writer", "config_schema_migration", "lossless_rmw", "idempotent_rewriter", "cross_runtime_integration"] }
    },
    "concurrency": {
      "type": "object",
      "description": "Required iff risk_flags includes runtime_concurrency (AC-553-3). scripts/validate-plan-contract.mjs rejects check-then-write/exists-then-create prose in concurrent_invoke_behavior (AC-553-4, WI-542 shape).",
      "properties": {
        "atomic_primitive": { "type": "string", "minLength": 1 },
        "owner_key": { "type": "string", "minLength": 1 },
        "concurrent_invoke_behavior": { "type": "string", "minLength": 1 },
        "stale_lock_cleanup": { "type": "string", "minLength": 1 },
        "concurrency_test": { "type": "string", "minLength": 1 }
      }
    },
    "external_writer": {
      "type": "object",
      "description": "Required iff risk_flags includes external_state_writer or idempotent_rewriter (AC-553-3). scripts/validate-plan-contract.mjs rejects immutable_baseline === rolling_rollback — one backup path cannot serve both roles (AC-553-4, WI-542 shape).",
      "properties": {
        "immutable_baseline": { "type": "string", "minLength": 1 },
        "rolling_rollback": { "type": "string", "minLength": 1 },
        "read_failure_policy": { "type": "string", "minLength": 1 },
        "file_mode_preservation": { "type": "string", "minLength": 1 }
      }
    },
    "lossless_rmw": {
      "type": "object",
      "description": "Required iff risk_flags includes lossless_rmw (AC-553-3). Every documented entry type requires a fixture (AC-553-4, WI-542 shape).",
      "properties": {
        "entry_types": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "object", "required": ["type", "fixture"], "properties": { "type": { "type": "string", "minLength": 1 }, "fixture": { "type": "string", "minLength": 1 } } }
        }
      }
    },
    "idempotent_rewriter": {
      "type": "object",
      "description": "Required iff risk_flags includes idempotent_rewriter (AC-553-3).",
      "properties": {
        "proof": { "type": "string", "minLength": 1 }
      }
    }
  }
}
