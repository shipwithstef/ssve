{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "svc reconcile detached drive outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_sha", "generation", "pid", "state", "exit_classification", "started_at", "ended_at", "watcher_cutoff", "diagnostic"],
  "properties": {
    "schema_version": {"const": 1},
    "target_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "generation": {"type": "string", "format": "uuid"},
    "pid": {"type": ["integer", "null"], "minimum": 1},
    "state": {"type": "string", "enum": ["running", "terminal"]},
    "exit_classification": {"type": ["string", "null"], "enum": ["success", "timeout", "error", "spawn-error", null]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "watcher_cutoff": {"type": ["string", "null"]},
    "diagnostic": {"type": "string"}
  }
}
