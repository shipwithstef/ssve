{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seriousvibecoding.dev/schemas/owner-decision-v2.schema.json",
  "title": "SVC owner decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "run_id",
    "mode",
    "language",
    "question_digest",
    "question",
    "options",
    "selected_option_id",
    "rejected_option_ids",
    "technique_order",
    "authority",
    "evidence_ids",
    "uncertainty_ids",
    "generation_bindings"
  ],
  "properties": {
    "schema_version": { "const": "owner-decision-v2" },
    "decision_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["autonomous", "strategic"] },
    "language": { "type": "string", "minLength": 2 },
    "question_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "question": { "type": "string", "minLength": 1 },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option_id", "hard_constraints_pass", "evidence_weight", "expected_product_value", "value_of_information", "max_regret", "reversibility", "critical_path_minutes"],
        "properties": {
          "option_id": { "type": "string", "minLength": 1 },
          "hard_constraints_pass": { "type": "boolean" },
          "evidence_weight": { "type": "number", "minimum": 0 },
          "expected_product_value": { "type": "number" },
          "value_of_information": { "type": "number", "minimum": 0 },
          "max_regret": { "type": "number", "minimum": 0 },
          "reversibility": { "type": "number", "minimum": 0 },
          "critical_path_minutes": { "type": "number", "minimum": 0 }
        }
      }
    },
    "selected_option_id": { "type": "string", "minLength": 1 },
    "rejected_option_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "technique_order": {
      "const": ["hard-constraint", "evidence", "expected-product-value", "value-of-information", "minimax-regret", "reversibility", "critical-path-fit"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "principal", "delegation_digest", "within_delegation"],
      "properties": {
        "surface": { "const": "decide" },
        "principal": { "type": "string", "minLength": 1 },
        "delegation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "within_delegation": { "type": "boolean" }
      }
    },
    "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "uncertainty_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "generation_bindings": { "$ref": "execution-task-capsule-v2.schema.json#/$defs/generationBindings" }
  }
}
