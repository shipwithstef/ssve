{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WI-472 independently reviewed reconcile backlog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "wi", "ledger_sha256", "bundle_sha256", "producer", "reviewer", "zero_waivers_verified", "verdict", "reviewed_at", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "wi": {"const": "WI-472"},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {"type": "object", "required": ["host", "family", "run_id"]},
    "reviewer": {"type": "object", "required": ["host", "family", "model", "run_id", "request_id", "package_sha256", "receipt", "receipt_sha256", "findings", "findings_sha256"]},
    "zero_waivers_verified": {"const": true},
    "verdict": {"type": "string", "enum": ["pass", "fail"]},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "rows": {
      "type": "array",
      "minItems": 78,
      "maxItems": 78,
      "items": {
        "type": "object",
        "required": ["sha", "disposition", "evidence_checked", "verdict", "finding_ids"],
        "properties": {
          "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "disposition": {"type": "string"},
          "evidence_checked": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verdict": {"type": "string", "enum": ["approve", "reject"]},
          "finding_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
