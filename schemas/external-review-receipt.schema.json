{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "svc-external-review-receipt-v2",
  "title": "SVC external review invocation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "launcher_version",
    "cli_version",
    "request_id",
    "review_kind",
    "candidate_digest",
    "package_sha256",
    "findings_schema_sha256",
    "findings_sha256",
    "cache_key",
    "fixture_mode",
    "started_at",
    "finished_at",
    "status",
    "classification",
    "requested_tuple",
    "invocation_tuple",
    "effective_tuple",
    "attempts",
    "fallback",
    "override",
    "policy",
    "protocol",
    "route",
    "effective_effort",
    "model_attestation",
    "phase_guard",
    "package_context",
    "cache",
    "artifacts",
    "usage",
    "reviewer_run"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "launcher_version": {
      "type": "string"
    },
    "cli_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "review_kind": {
      "type": "string"
    },
    "candidate_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "package_sha256": {
      "type": "string"
    },
    "findings_schema_sha256": {
      "type": "string"
    },
    "findings_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "cache_key": {
      "type": "string"
    },
    "fixture_mode": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "success",
        "cache_hit",
        "input_invalid",
        "config_invalid",
        "internal_failure",
        "disabled",
        "capability",
        "model_unavailable",
        "model_entitlement",
        "provider_overload",
        "authentication",
        "shared_quota",
        "network",
        "timeout",
        "budget_exhausted",
        "cancelled",
        "schema_invalid",
        "schema_turn_budget",
        "model_mismatch",
        "profile_selection_invalid",
        "provider_safety_failure",
        "override_invalid",
        "phase_violation",
        "fallback_failed",
        "lock_failure",
        "unknown_provider"
      ]
    },
    "requested_tuple": {
      "anyOf": [
        {
          "$ref": "#/definitions/tuple"
        },
        {
          "type": "null"
        }
      ]
    },
    "invocation_tuple": {
      "anyOf": [
        {
          "$ref": "#/definitions/tuple"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_tuple": {
      "anyOf": [
        {
          "$ref": "#/definitions/tuple"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "tuple",
          "started_at",
          "finished_at",
          "exit_code",
          "classification",
          "artifacts"
        ],
        "properties": {
          "index": {
            "type": "integer"
          },
          "tuple": {
            "$ref": "#/definitions/tuple"
          },
          "started_at": {
            "type": "string"
          },
          "finished_at": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "success",
              "capability",
              "model_unavailable",
              "model_entitlement",
              "provider_overload",
              "authentication",
              "shared_quota",
              "network",
              "timeout",
              "budget_exhausted",
              "cancelled",
              "schema_invalid",
              "schema_turn_budget",
              "model_mismatch",
              "provider_safety_failure",
              "unknown_provider"
            ]
          },
          "command": {
            "type": "object",
            "required": [
              "binary",
              "argv"
            ],
            "properties": {
              "binary": {
                "type": "string"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "artifacts": {
            "type": "object"
          },
          "usage": {
            "type": "object"
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "used",
        "reason"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "authority",
        "source",
        "path",
        "expected_sha256",
        "actual_sha256"
      ],
      "properties": {
        "used": {
          "type": "boolean"
        },
        "authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "actual_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profile",
        "source",
        "resolved_at",
        "effective_window",
        "cutover_utc",
        "cutover_local",
        "timezone",
        "selection_sha256",
        "selection_expires_at",
        "selection_authority"
      ],
      "properties": {
        "version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "schedule",
            "explicit-selection",
            "fixed-policy",
            "owner-config",
            null
          ]
        },
        "resolved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_window": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "starts_at",
                "ends_at"
              ],
              "properties": {
                "starts_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ends_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "cutover_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "cutover_local": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_authority": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_invocations",
        "configured_turn_ceiling",
        "configured_budget_usd",
        "reported_turns",
        "stop_reason",
        "terminal_reason",
        "errors"
      ],
      "properties": {
        "process_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "configured_turn_ceiling": {
          "type": [
            "integer",
            "null"
          ]
        },
        "configured_budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "reported_turns": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "switching_enabled",
        "cli_fallback_configured",
        "evidence"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact_primary",
            "scheduled_primary",
            "explicit_profile_primary",
            "owner_config_primary",
            "provider_safety_route",
            "launcher_availability_fallback",
            "cache_hit",
            "hard_failure"
          ]
        },
        "switching_enabled": {
          "type": "boolean"
        },
        "cli_fallback_configured": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "enum": [
            "requested_primary",
            "provider_model_usage_envelope_inferred",
            "launcher_attempt_chain",
            "cache_receipt_replay",
            "failure"
          ]
        }
      }
    },
    "effective_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "provider-managed",
            null
          ]
        },
        "provenance": {
          "type": "string",
          "enum": [
            "runtime",
            "requested",
            "provider-managed",
            "none"
          ]
        }
      }
    },
    "model_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "requested_model",
        "observed_models",
        "evidence"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "none",
            "requested_accepted",
            "server_observed",
            "cache_replay"
          ]
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "phase_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "kind",
        "decision",
        "reason",
        "wi",
        "pre_execution_base",
        "plan_manifest_sha256",
        "exec_record_present",
        "exec_record_path",
        "implementation_diverged",
        "diverged_files",
        "base_resolved",
        "override"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "allow-override",
            "reject",
            "not-applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "wi": {
          "type": [
            "string",
            "null"
          ]
        },
        "pre_execution_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "exec_record_present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exec_record_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_diverged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "diverged_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base_resolved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "used",
            "authority",
            "source",
            "path",
            "expected_sha256",
            "actual_sha256",
            "kind"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "authority": {
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "expected_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "actual_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "package_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "context_root",
        "base_package_sha256",
        "files"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "context_root": {
          "type": "string"
        },
        "base_package_sha256": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reusable",
        "entry"
      ],
      "properties": {
        "disposition": {
          "type": "string",
          "enum": [
            "skipped",
            "miss",
            "hit",
            "published",
            "not_reusable"
          ]
        },
        "reusable": {
          "type": "boolean"
        },
        "entry": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    },
    "reviewer_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "output_artifacts"
      ],
      "properties": {
        "commands": {
          "type": "array"
        },
        "output_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestrator",
        "host",
        "family",
        "model",
        "effort"
      ],
      "properties": {
        "orchestrator": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "provider-managed"
          ]
        }
      }
    }
  }
}
