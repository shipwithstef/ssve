{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://serious-vibe-coding.local/schemas/delegation-completion-receipt.schema.json",
  "title": "Delegated task completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "delegation_id", "child_principal", "authority_generation",
    "task_id", "base_sha", "head_sha", "commits", "files_written", "diff_digest",
    "validation", "clean_worktree", "completed_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "delegation_id": { "type": "string", "format": "uuid" },
    "child_principal": { "type": "string" },
    "authority_generation": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commits": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } },
    "files_written": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "diff_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "validation": { "type": "array", "items": { "type": "object" } },
    "clean_worktree": { "type": "boolean" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
