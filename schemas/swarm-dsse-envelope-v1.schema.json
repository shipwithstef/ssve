{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seriousvibecoding.dev/schemas/swarm-dsse-envelope-v1.schema.json",
  "title": "SVC Swarm DSSE Envelope v1",
  "type": "object",
  "required": ["payloadType", "payload", "signatures"],
  "additionalProperties": false,
  "properties": {
    "payloadType": {
      "enum": [
        "application/vnd.svc.swarm-receipt+json;version=1",
        "application/vnd.svc.swarm-command+json;version=1"
      ]
    },
    "payload": { "type": "string", "contentEncoding": "base64" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["keyid", "sig"],
        "additionalProperties": false,
        "properties": {
          "keyid": { "type": "string", "minLength": 1 },
          "sig": { "pattern": "^[A-Za-z0-9+/]+=*$" }
        }
      }
    }
  }
}
