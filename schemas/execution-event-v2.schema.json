{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seriousvibecoding.dev/schemas/execution-event-v2.schema.json",
  "title": "SVC Execution Event v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "type",
    "task_id",
    "generation_bindings",
    "observed_at",
    "previous_event_digest",
    "payload",
    "event_digest"
  ],
  "properties": {
    "schema_version": { "type": "integer", "enum": [2] },
    "run_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": {
      "type": "string",
      "enum": [
        "RUN_CREATED",
        "TASK_STARTED",
        "STATIC_PASSED",
        "RUNTIME_PASSED",
        "CHECKPOINT_CREATED",
        "TASK_ACCEPTED",
        "FAILURE_RECORDED",
        "ASSIST_AUTHORIZED",
        "PLAN_AMENDED",
        "EXTERNAL_WAIT_STARTED",
        "EXTERNAL_WAIT_ENDED",
        "RUN_CANCELLED"
      ]
    },
    "task_id": { "type": "string" },
    "generation_bindings": {
      "type": "object",
      "required": [
        "protocol_generation_digest", "product_generation_digest", "context_generation_digest",
        "concern_generation_digest", "control_generation_digest", "authority_generation_digest",
        "layer_inventory_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "product_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "context_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "concern_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "control_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authority_generation_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "layer_inventory_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "observed_at": { "type": "string" },
    "previous_event_digest": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "event_digest": { "type": "string" }
  }
}
