[Unit]
Description=Orchestrator OS Azure Scheduled Events checkpoint watcher
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ORCH_ROOT@
Environment=PATH=@ORCH_PATH@
UMask=0077
ExecStart=@ORCH_NODE@ @ORCH_ROOT@/scripts/orch/preempt-watch.mjs
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
