{
  "host": "codex",
  "name": "OpenAI Codex CLI",
  "skills_path": "~/.codex/skills",
  "builder_profile_path": "~/.svc/builder-profile.md",
  "capabilities": {
    "skills": true,
    "hooks": true,
    "plugins": true,
    "mcp": true,
    "commands": true,
    "agents": true,
    "child_transport_resolver": "scripts/resolve-child-transport.mjs",
    "authorized_action_wrapper": "scripts/svc-authorized-action.mjs"
  },
  "runtime_ingress_v2": { "transport": "hook-adapter", "fallback": "cli-adapter", "canonical_journal": true, "projection_only": true },
  "authority_capabilities": {
    "stable_session_identity": true,
    "stable_child_identity": true,
    "identity_source": "session_id plus persisted dispatch child principal",
    "filesystem_containment": "wrapper",
    "containment_backend": "landlock",
    "containment_launcher": "scripts/svc-contained-exec.mjs",
    "containment_probe_required": true,
    "mutating_child_execution": true,
    "fresh_session_launch": {
      "enabled": false,
      "reason": "No automatable fresh-session transport declared for this host yet (WI-552 migration note: disabled by default until a host manifest declares fresh_session_launch)."
    },
    "isolated_plan_analysis": {
      "enabled": true,
      "grants_runtime_isolation": false,
      "availability_only": true,
      "adapter": "codex-exec",
      "transport": "frozen-payload",
      "tool_free": true,
      "note": "enabled means the Codex exec frozen-payload adapter is available. Each invocation still requires passing effective preflight. This field describes availability and never grants runtime isolation by itself.",
      "exec_argv": [
        "--ephemeral",
        "--sandbox",
        "read-only",
        "--ignore-user-config",
        "--skip-git-repo-check",
        "--json",
        "--output-schema"
      ],
      "model_flag": "-m",
      "effort_flag": "-c",
      "effort_config_key": "model_reasoning_effort",
      "stdin_prompt": true,
      "neutral_cwd": true,
      "no_resume_or_fork": true,
      "forbidden_isolation_substitutes": [
        "--read-only",
        "--ignore-rules",
        "landlock",
        "svc-contained-exec",
        "fresh_session_launch"
      ],
      "invocation_overrides": {
        "project_doc_max_bytes": 0,
        "web_search": "disabled",
        "developer_instructions": "",
        "features": {
          "skip_host_skill_discovery": true,
          "shell_tool": false,
          "unified_exec": false,
          "multi_agent": false,
          "multi_agent_v2": false,
          "plugins": false,
          "apps": false,
          "view_image": false,
          "browser_use": false,
          "computer_use": false,
          "memories": false,
          "remote_plugin": false,
          "workspace_dependencies": false,
          "skill_search": false,
          "image_generation": false,
          "hooks": false,
          "code_mode": false,
          "code_mode_host": false,
          "tool_suggest": false
        },
        "skills_config": {
          "disable_discovered": true,
          "scope": ["global", "system", "plugin"],
          "mutate_skill_files": false
        }
      },
      "prompt_inspection": {
        "required": true,
        "command": "codex debug prompt-input",
        "builder": "same_as_live_launch",
        "scope": "invocation",
        "cwd": "neutral_temporary_directory",
        "must_absent": [
          "ssve_skill_catalog",
          "project_or_global_methodology_injection",
          "competing_candidate"
        ],
        "native_host_safety_message_allowed": true,
        "large_request": {
          "planning_max_bytes": 1048576,
          "native_inspect": "positional_prompt_input",
          "native_inspect_complete_input": false,
          "oversized_prompt_transport": "native_request_capture",
          "capture_is_live_authority": false,
          "qualified_inspect_authorizes_live_stdin": true,
          "token_budget_separate_from_bytes": true,
          "inference_uses_stdin": true
        }
      },
      "live_canary": {
        "required": true,
        "tool_events": "abort_on_any",
        "offline_never_unlocks_live": true,
        "facts_marker_required": true,
        "bounded": true
      }
    }
  },
  "hook_events": [
    "SessionStart",
    "PreToolUse",
    "PermissionRequest",
    "PostToolUse",
    "UserPromptSubmit",
    "Stop"
  ],
  "hook_quirks": {
    "feature_flag_required": "hooks",
    "feature_flag_file": "~/.codex/config.toml",
    "timeout_unit": "s",
    "tool_matchers": [
      "Bash",
      "apply_patch",
      "Edit",
      "Write",
      "MCP tools"
    ],
    "config_file": ".codex/hooks.json",
    "windows_native_supported": true,
    "wsl2_supported": true,
    "wsl2_requires_linux_node": true
  },
  "task_graph": {
    "task_ui": "update_plan",
    "background_tasks": false,
    "skill_load_mode": "direct_skill_file",
    "native_task_read_tools": []
  },
  "infra_files": [
    "DOCTRINE.md",
    "REPO_MODES.md",
    "WORKTREES.md",
    "EXTERNAL_ADDONS.md",
    "FRAMEWORK-STATE.md",
    "skills-manifest.json",
    "CONTRIBUTING.md"
  ],
  "infra_dirs": [
    "scripts",
    "references",
    "proposals",
    "examples",
    "hooks",
    "provision",
    "templates",
    "_shared",
    "concerns"
  ],
  "skip": [],
  "post_install_commands": [
    "bash {skills_path}/scripts/install-browse.sh"
  ],
  "verify_commands": [
    "test -f {skills_path}/route-workflow/SKILL.md",
    "test -f {skills_path}/DOCTRINE.md",
    "test -f {skills_path}/skills-manifest.json",
    "test -f {skills_path}/scripts/install-browse.sh"
  ],
  "wiring": {
    "hook_capable": true,
    "wirer": "scripts/wire-codex-hooks.mjs",
    "wirer_via": "case",
    "governed": true,
    "governed_token": [
      "svc-enforce",
      "svc-codex-pretool-dispatcher"
    ],
    "config_file": "~/.codex/hooks.json",
    "effective_state": {
      "type": "codex-hooks-state",
      "config_file": "~/.codex/config.toml"
    },
    "enforcement": "launcher"
  }
}
