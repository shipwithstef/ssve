{
  "host": "grok",
  "name": "Grok Build CLI",
  "skills_path": "~/.grok/skills",
  "rules_path": "~/.grok/rules",
  "builder_profile_path": "~/.svc/builder-profile.md",
  "capabilities": {
    "skills": true,
    "hooks": true,
    "plugins": true,
    "mcp": true,
    "commands": true,
    "agents": true
  },
  "runtime_ingress_v2": { "transport": "hook-adapter", "fallback": "cli-adapter", "canonical_journal": true, "projection_only": true },
  "authority_capabilities": {
    "stable_session_identity": true,
    "stable_child_identity": true,
    "identity_source": "session hook identity plus persisted dispatch child principal",
    "filesystem_containment": "wrapper",
    "containment_backend": "landlock",
    "containment_launcher": "scripts/svc-contained-exec.mjs",
    "containment_probe_required": true,
    "mutating_child_execution": true,
    "fresh_session_launch": {
      "enabled": true,
      "transport": "cli-launch",
      "event": "SessionStart",
      "launch_command": "grok --cwd \"${SVC_LAUNCH_CWD:-$PWD}\" --model grok-4.6 --effort \"${SVC_GROK_EFFORT:-high}\" --permission-mode auto --output-format json --max-turns \"${SVC_GROK_MAX_TURNS:-80}\" --prompt-file \"${SVC_PROMPT_FILE}\"",
      "note": "WI-FW-CROSS-REPO-ORCH-01: real Grok CLI launch. Continuation spawn sets SVC_PROMPT_FILE and SVC_LAUNCH_CWD. Cursor origin dispatches PLAN/EXEC here; this is not isolated_plan_analysis."
    },
    "isolated_plan_analysis": {
      "enabled": false,
      "grants_runtime_isolation": false,
      "availability_only": true,
      "reason": "Grok Build CLI fresh_session_launch is not isolated_plan_analysis; this host has no tested frozen-payload tool-free adapter with invocation-scoped prompt-inspection and live canary. Pending equivalent adapter proof."
    }
  },
  "hook_events": [
    "PreToolUse",
    "PostToolUse",
    "PostToolUseFailure",
    "UserPromptSubmit",
    "Stop",
    "StopFailure",
    "SessionStart",
    "SessionEnd"
  ],
  "hook_quirks": {
    "config_file": "~/.grok/config.toml",
    "config_format": "toml",
    "parallel_execution": true,
    "tool_matcher_regex": true,
    "timeout_unit": "s",
    "timeout_default": 30,
    "toml_table_shape": "[[hooks.<Event>]]",
    "handler_shape": "hooks = [{ type, command, timeout }]",
    "session_start_healthcheck_timeout_s": 30,
    "decision_format": "hookSpecificOutput.permissionDecision"
  },
  "task_graph": {
    "task_ui": "TaskList/TaskOutput (observational); .svc/lane-tasks-<WI>.json remains source of truth",
    "background_tasks": true,
    "skill_load_mode": "slash_skill_or_direct_skill_file",
    "native_task_read_tools": ["TaskList", "TaskOutput"]
  },
  "infra_files": [
    "DOCTRINE.md",
    "REPO_MODES.md",
    "WORKTREES.md",
    "EXTERNAL_ADDONS.md",
    "FRAMEWORK-STATE.md",
    "skills-manifest.json",
    "CONTRIBUTING.md",
    "GROK.md"
  ],
  "infra_dirs": [
    "scripts",
    "references",
    "proposals",
    "examples",
    "hooks",
    "provision",
    "agents",
    "templates",
    "_shared",
    "concerns"
  ],
  "skip": [],
  "post_install_commands": [
    "node {skills_path}/scripts/wire-grok-hooks.mjs --skills-path {skills_path}"
  ],
  "verify_commands": [
    "test -f {skills_path}/route-workflow/SKILL.md",
    "test -f {skills_path}/DOCTRINE.md",
    "test -f {skills_path}/skills-manifest.json",
    "test -f {skills_path}/scripts/worktree.sh",
    "test -d {skills_path}/templates/.svc"
  ],
  "wiring": {
    "hook_capable": true,
    "wirer": "scripts/wire-grok-hooks.mjs",
    "wirer_via": "post_install",
    "governed": true,
    "governed_token": [
      "svc-enforce",
      "svc-grok-task-completion-guard"
    ],
    "config_file": "~/.grok/config.toml",
    "enforcement": "launcher"
  }
}
