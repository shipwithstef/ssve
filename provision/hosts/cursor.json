{
  "host": "cursor",
  "name": "Cursor",
  "skills_path": "~/.cursor/skills",
  "rules_path": "",
  "builder_profile_path": "~/.svc/builder-profile.md",
  "capabilities": {
    "skills": true,
    "hooks": false,
    "plugins": true,
    "mcp": true,
    "commands": true,
    "agents": true
  },
  "runtime_ingress_v2": { "transport": "cli-adapter", "fallback": "cli-adapter", "canonical_journal": true, "projection_only": true },
  "authority_capabilities": {
    "stable_session_identity": false,
    "stable_child_identity": false,
    "filesystem_containment": "none",
    "mutating_child_execution": false,
    "reason": "Hook wiring and trusted child identity are not verified."
  },
  "hook_events": [],
  "hook_quirks": {
    "config_file": ".cursor/hooks.json",
    "config_format": "json",
    "skill_load_mode": "skill_or_slash_command",
    "notes": "Cursor 2.4+ supports Agent Skills in SKILL.md files. Hook wiring is intentionally disabled until svc has a verified Cursor-specific wirer."
  },
  "task_graph": {
    "task_ui": "none; use .svc/lane-tasks-<WI>.json as source of truth",
    "background_tasks": false,
    "skill_load_mode": "slash_skill_or_direct_skill_file",
    "native_task_read_tools": []
  },
  "infra_files": [
    "DOCTRINE.md",
    "REPO_MODES.md",
    "WORKTREES.md",
    "EXTERNAL_ADDONS.md",
    "FRAMEWORK-STATE.md",
    "skills-manifest.json",
    "CONTRIBUTING.md",
    "AGENTS.md"
  ],
  "infra_dirs": [
    "scripts",
    "references",
    "proposals",
    "examples",
    "hooks",
    "provision",
    "agents",
    "templates",
    "_shared",
    "concerns"
  ],
  "skip": [],
  "post_install_commands": [],
  "verify_commands": [
    "test -f {skills_path}/route-workflow/SKILL.md",
    "test -f {skills_path}/DOCTRINE.md",
    "test -f {skills_path}/skills-manifest.json",
    "test -f {skills_path}/scripts/worktree.sh",
    "test -d {skills_path}/templates/.svc"
  ],
  "wiring": {
    "hook_capable": false,
    "wirer": null,
    "wirer_via": null,
    "governed": false,
    "governed_token": null,
    "config_file": null,
    "enforcement": "none",
    "reason": "Hook wiring intentionally pending a verified Cursor-specific wirer (capabilities.hooks=false); skills-only enforcement surface. Explicitly non-hook-capable."
  }
}
