#!/usr/bin/env bash
# svc pre-push slot: verify chain receipts complete for pushed commits.
#
# Phase A-D behavior: warn-only.
# Phase E flip: refuse push when receipts incomplete.

set -u
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Detect mode via the WI-549 shared resolver: SVC_CHAIN_POLICY env ->
# $(git-common-dir)/svc-chain-policy.json -> ~/.svc/chain-policy.json ->
# fail-closed "refuse". A missing/unreadable policy, or a worktree-local
# .svc/chain-policy.json that conflicts with the shared one, resolves to
# "refuse" and prints diagnostics to stderr — never a silent "warn".
MODE="$(node "$REPO_ROOT/scripts/lib/chain-policy.mjs" --mode)"

# Permanent, narrow framework-maintenance lane.  A Codex maintenance commit in
# the canonical SVC main checkout carries an explicit urgent-maintenance body
# marker and the required Codex co-author trailer.  It is not a general receipt
# waiver: product repositories, child worktrees, ordinary framework commits,
# and mixed ranges still take the normal chain gate.
framework_maintenance_range() {
  local range="$1" sha subject body
  [[ "$(git branch --show-current 2>/dev/null)" == "main" ]] || return 1
  [[ -f skills-manifest.json && -f FRAMEWORK-STATE.md && -f hooks/hooks.json && -f setup ]] || return 1
  while read -r sha; do
    [[ -z "$sha" ]] && continue
    subject="$(git show -s --format=%s "$sha")"
    body="$(git show -s --format=%B "$sha")"
    [[ "$body" == *"Urgent-maintenance:"* ]] || return 1
    [[ "$body" == *"Co-Authored-By: Codex CLI <contact-b6b620a2d4@example.invalid>"* ]] || return 1
    [[ "$subject" == fix\(codex\):* ]] || return 1
  done < <(git rev-list "$range")
  return 0
}

# Read the push refs from stdin (git pre-push protocol)
HAS_ISSUES="false"
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "$local_sha" ]] && continue
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
  # Skip svc receipt notes ref — those are receipt-storage commits, not
  # branch commits that need chain receipts of their own.
  case "$local_ref" in
    refs/notes/svc-receipts|refs/notes/*) continue ;;
  esac

  # Determine one exact commit range per pushed branch ref. The receipt checker
  # owns enumeration so pre-push never pays one Node startup per SHA.
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    MAIN_REF="$(git rev-parse --verify origin/main 2>/dev/null || git rev-parse --verify origin/HEAD 2>/dev/null || echo "")"
    if [[ -n "$MAIN_REF" ]]; then
      RANGE="$MAIN_REF..$local_sha"
    else
      RESULT="$(node scripts/check-chain-receipts.mjs --sha "$local_sha" 2>/dev/null)"
    fi
  else
    RANGE="$remote_sha..$local_sha"
  fi

  if [[ -n "${RANGE:-}" ]]; then
    RESULT="$(node scripts/check-chain-receipts.mjs --range "$RANGE" 2>/dev/null)"
  fi
  if [[ -n "${RANGE:-}" ]] && framework_maintenance_range "$RANGE"; then
    echo "svc chain: framework maintenance receipt exception for $RANGE" >&2
    RESULT='{"ok":true,"maintenance":true}'
  fi
  OK="$(echo "$RESULT" | grep -o '"ok":[^,}]*' | head -1 | cut -d: -f2 | tr -d ' ')"
  if [[ "$OK" != "true" ]]; then
    HAS_ISSUES="true"
    echo "svc chain: receipts incomplete for ${RANGE:-$local_sha}" >&2
    echo "$RESULT" >&2
  fi
  unset RANGE RESULT
done

if [[ "$HAS_ISSUES" == "true" ]]; then
  if [[ "$MODE" == "refuse" ]]; then
    echo "svc chain: push refused. Run retroactive plan or use EMERGENCY_OVERRIDE." >&2
    exit 1
  fi
  echo "svc chain: WARN-ONLY mode. Push proceeds." >&2
fi
exit 0
