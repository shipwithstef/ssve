+    ".svc"
+  ],
+  "resource_review": {
+    "verification": "changed-executable-census",
+    "denominator": 4,
+    "disposition": "no-risky-resource-writers",
+    "evidence": "changed executables: scripts/compile-skill-router-index.mjs, scripts/skill-router.mjs, scripts/lib/skill-router.mjs, test-framework/evals/tier-1/validate-skill-router.sh — a deterministic compiler, a suggestion-only CLI, a library, and a hermetic validator; none write money/ledger/quota/identity state; the receipts stream under .svc/ is observational and gitignored"
+  },
+  "resource_writers": [],
+  "claims": [
+    {
+      "kind": "absence",
+      "evidence": {
+        "verification": "diff-manifest-parity"
+      },
+      "denominator": 0
+    },
+    {
+      "kind": "unused",
+      "evidence": {
+        "verification": "executable-consumers"
+      },
+      "denominator": 0
+    }
+  ],
+  "external_writer": {
+    "immutable_baseline": "git show HEAD:references/skill-routing-index.json (committed artifact at base SHA)",
+    "rolling_rollback": "references/skill-routing-index.json regenerated on demand by scripts/compile-skill-router-index.mjs from canonical inputs",
+    "read_failure_policy": "if the committed artifact is unreadable or hash-mismatched, the tier-1 validator fails closed with a named reason; routing callers fall back to exact name resolution only and record degraded mode",
+    "file_mode_preservation": "compiler writes via temp-file atomic rename preserving 0644 regular-file mode; no symlink following"
+  },
+  "idempotent_rewriter": {
+    "proof": "compiler output is a pure function of canonical inputs: deterministic sort order, stable sha256 content hashes, schema_version stamp. Attempt N for identical inputs writes byte-identical bytes to attempt 1, so the committed baseline can never be silently overwritten by drift — validate-skill-router.sh recompiles and byte-diffs, failing closed on any divergence"
+  },
+  "executables": [
+    {
+      "path": "scripts/compile-skill-router-index.mjs",
+      "consumers": [
+        "test-framework/evals/tier-1/validate-skill-router.sh"
+      ]
+    },
+    {
+      "path": "scripts/skill-router.mjs",
+      "consumers": [
+        "test-framework/evals/tier-1/validate-skill-router.sh"
+      ]
+    },
+    {
+      "path": "scripts/lib/skill-router.mjs",
+      "consumers": [
+        "scripts/skill-router.mjs"
+      ]
+    },
+    {
+      "path": "test-framework/evals/tier-1/validate-skill-router.sh",
+      "consumers": [
+        {
+          "path": "test-framework/evals/run-all-evals.sh",
+          "query": "tier-1"
+        }
+      ]
+    }
+  ]
+}
