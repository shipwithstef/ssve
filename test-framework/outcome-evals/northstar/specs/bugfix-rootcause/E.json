{
 "component": "E",
 "task": "bugfix-rootcause",
 "checks": [
  {
   "type": "cases",
   "cases": [
    {
     "name": "an empty schedule groups to nothing",
     "steps": [
      {
       "fn": "groupByDay",
       "args": [
        []
       ],
       "module": "src/schedule.mjs",
       "equals": {}
      }
     ]
    },
    {
     "name": "invalid timestamps never become a garbage day",
     "steps": [
      {
       "fn": "groupByDay",
       "args": [
        [
         {
          "id": "x",
          "name": "X",
          "startsAt": null
         }
        ]
       ],
       "module": "src/schedule.mjs",
       "expect": "clean",
       "crash": [
        "ReferenceError"
       ],
       "assert": "!/Invalid|NaN|undefined|null/.test(JSON.stringify(Object.keys(r||{})))"
      },
      {
       "fn": "dayKey",
       "args": [
        "not a time"
       ],
       "module": "src/dates.mjs",
       "expect": "clean",
       "crash": [
        "ReferenceError"
       ],
       "assert": "!/Invalid|NaN/.test(typeof r==='string'?r:'')"
      }
     ]
    },
    {
     "name": "the studio day turns over at local midnight",
     "steps": [
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-10-11T12:59:59.999Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-10-11"
      },
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-10-11T13:00:00Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-10-12"
      }
     ]
    },
    {
     "name": "the clocks going forward keep one studio day",
     "steps": [
      {
       "fn": "groupByDay",
       "args": [
        [
         {
          "id": "a",
          "name": "A",
          "startsAt": {
           "$js": "Date.parse('2026-10-03T15:59:00Z')"
          }
         },
         {
          "id": "b",
          "name": "B",
          "startsAt": {
           "$js": "Date.parse('2026-10-03T16:00:00Z')"
          }
         }
        ]
       ],
       "module": "src/schedule.mjs",
       "assert": [
        "Object.keys(r).join()==='2026-10-04'",
        "r['2026-10-04'].map(c=>c.time).join()==='01:59,03:00'"
       ]
      }
     ]
    },
    {
     "name": "the clocks going back keep one studio day",
     "steps": [
      {
       "fn": "groupByDay",
       "args": [
        [
         {
          "id": "a",
          "name": "A",
          "startsAt": {
           "$js": "Date.parse('2027-04-03T15:30:00Z')"
          }
         },
         {
          "id": "b",
          "name": "B",
          "startsAt": {
           "$js": "Date.parse('2027-04-03T16:30:00Z')"
          }
         }
        ]
       ],
       "module": "src/schedule.mjs",
       "assert": [
        "Object.keys(r).join()==='2027-04-04'",
        "r['2027-04-04'].map(c=>c.time).join()==='02:30,02:30'"
       ]
      }
     ]
    },
    {
     "name": "the new year and a leap day land on the right studio day",
     "steps": [
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-12-31T13:00:00Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2027-01-01"
      },
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-12-31T12:59:59Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-12-31"
      },
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2028-02-28T13:00:00Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2028-02-29"
      }
     ]
    },
    {
     "name": "the free trial rule holds across local midnight",
     "steps": [
      {
       "op": "eval",
       "js": "v.b=[{userId:'u1',trial:true,startsAt:Date.parse('2026-10-11T13:10:00Z')}]"
      },
      {
       "fn": "canUseTrial",
       "args": [
        {
         "$var": "b"
        },
        "u1",
        {
         "$js": "Date.parse('2026-10-12T12:50:00Z')"
        }
       ],
       "module": "src/trials.mjs",
       "equals": false
      },
      {
       "fn": "canUseTrial",
       "args": [
        {
         "$var": "b"
        },
        "u1",
        {
         "$js": "Date.parse('2026-10-11T12:50:00Z')"
        }
       ],
       "module": "src/trials.mjs",
       "equals": true
      }
     ]
    },
    {
     "name": "other customers and non-trial bookings do not block a trial",
     "steps": [
      {
       "fn": "canUseTrial",
       "args": [
        [],
        "u1",
        {
         "$js": "Date.parse('2026-10-12T05:00:00Z')"
        }
       ],
       "module": "src/trials.mjs",
       "equals": true
      },
      {
       "fn": "canUseTrial",
       "args": [
        [
         {
          "userId": "u2",
          "trial": true,
          "startsAt": {
           "$js": "Date.parse('2026-10-12T05:00:00Z')"
          }
         },
         {
          "userId": "u1",
          "trial": false,
          "startsAt": {
           "$js": "Date.parse('2026-10-12T05:00:00Z')"
          }
         }
        ],
        "u1",
        {
         "$js": "Date.parse('2026-10-12T06:00:00Z')"
        }
       ],
       "module": "src/trials.mjs",
       "equals": true
      },
      {
       "fn": "canUseTrial",
       "args": [
        [
         {
          "userId": "u1",
          "trial": true,
          "startsAt": {
           "$js": "Date.parse('2026-10-12T05:00:00Z')"
          }
         }
        ],
        "u1",
        {
         "$js": "Date.parse('2026-10-12T06:00:00Z')"
        }
       ],
       "module": "src/trials.mjs",
       "equals": false
      }
     ]
    },
    {
     "name": "the studio zone comes from STUDIO_TZ",
     "env": {
      "STUDIO_TZ": "America/Los_Angeles"
     },
     "steps": [
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-10-12T06:00:00Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-10-11"
      },
      {
       "fn": "groupByDay",
       "args": [
        [
         {
          "id": "a",
          "name": "A",
          "startsAt": {
           "$js": "Date.parse('2026-10-12T06:00:00Z')"
          }
         }
        ]
       ],
       "module": "src/schedule.mjs",
       "assert": "r['2026-10-11'] && r['2026-10-11'][0].time==='23:00'"
      }
     ]
    },
    {
     "name": "winter days follow standard time, not a fixed summer offset",
     "steps": [
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-06-14T13:59:59Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-06-14"
      },
      {
       "fn": "dayKey",
       "args": [
        {
         "$js": "Date.parse('2026-06-14T14:00:00Z')"
        }
       ],
       "module": "src/dates.mjs",
       "equals": "2026-06-15"
      }
     ]
    }
   ]
  }
 ]
}