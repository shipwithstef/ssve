      "OWNER_USERNAME": "owner",
      "OWNER_PASSWORD": "Owner-Probe-Pass-7",
      "ADMIN_EMAIL": "owner@studio.test",
      "ADMIN_USERNAME": "owner",
      "ADMIN_PASSWORD": "Owner-Probe-Pass-7",
      "OWNER_TOKEN": "owner-probe-token-7",
      "ADMIN_TOKEN": "owner-probe-token-7"
    }
