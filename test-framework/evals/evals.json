    "tier-1": {
      "description": "Static validation scripts — no LLM, <10s, free",
      "scripts": [
        {
          "name": "validate-skill-structure",
          "path": "tier-1/validate-skill-structure.sh",
          "checks": "Every SKILL.md has name, description, inputs, outputs, chain in frontmatter. Pipeline Continuation section (except route-workflow, test-framework). Audit Mode section for the 11 skills that have it.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-contracts",
          "path": "tier-1/validate-contracts.sh",
          "checks": "Input paths use valid docs/specs/ patterns. Output paths don't conflict across skills. Status transitions are valid lifecycle values.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-chain-references",
          "path": "tier-1/validate-chain-references.sh",
          "checks": "Every chain.lanes.*.next and *.prev references a real skill in includedSkills. Lane skill lists in manifest match chain positions in individual SKILL.md frontmatter.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-self-verify-sections",
          "path": "tier-1/validate-self-verify-sections.sh",
          "checks": "Every skill with self_verify: true has a Self-Verify table with PASS/FAIL column.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-worktree-safety",
          "path": "tier-1/validate-worktree-safety.sh",
          "checks": ".gitignore has .worktrees/, scripts/worktree.sh exists, no orphaned worktrees.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-framework-self-management",
          "path": "tier-1/validate-framework-self-management.sh",
          "checks": "Cross-host task-graph contract uses lane-tasks.json as source of truth, Claude stop hook is optional acceleration, and svc-on-svc routing between improve-framework, diagnose-bug, write-spec, and explore-solutions is explicit.",
          "cost": "$0",
          "duration": "<5s"
        },
        {
          "name": "validate-frontmatter-ast",
          "path": "tier-1/validate-frontmatter-ast.mjs",
