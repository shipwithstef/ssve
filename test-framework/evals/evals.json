    "tier-3": {
      "description": "LLM-as-judge scoring — ~20K tokens per judgment",
      "runner": "tier-3/run-tier3.sh",
      "kimi_runner": "tier-3/run-tier3-kimi.sh",
      "judge_prompts": [
        {
          "name": "completeness",
          "path": "tier-3/judge-prompts/completeness.md",
          "scores": "0-10: does skill output address every input requirement?",
          "cost": "~20K tokens",
          "duration": "~1min"
        },
        {
          "name": "consistency",
          "path": "tier-3/judge-prompts/consistency.md",
          "scores": "0-10: does output contradict anything from prior phases?",
          "cost": "~20K tokens",
          "duration": "~1min"
        },
        {
          "name": "actionability",
          "path": "tier-3/judge-prompts/actionability.md",
          "scores": "0-10: can the next skill in the chain use this output?",
          "cost": "~20K tokens",
          "duration": "~1min"
        }
      ],
      "first_validated_scenario": "diagnose-bug-typo",
      "first_validation_date": "2026-04-23",
      "first_validation_scores": {
        "completeness": 10,
        "actionability": 10,
        "consistency": 10
      },
      "first_validation_notes": "Final v8 brief achieved 10/10/10 after 8 iterations. Key improvements: 15-section Bugfix Brief Template in skills/diagnose-bug/SKILL.md, complete diff rule (ALL affected lines), mandatory edge case analysis, N/A justification, regression guard scoping, artifact type labels, branch info, handoff status, risk/effort estimate, out-of-scope boundaries, external doc verification. Consistency judge requires prior phase artifacts (spec/journey files) in prompt. AP-26 confirmed: full skill-contract prompt causes scope explosion; template-driven prompt stays scoped."
    }
  },
  "evals": [
    {
      "id": 1,
      "suite": "pipeline-integrity",
      "prompt": "Run the pipeline integrity validation on the todo-api example",
      "expected_output": "All checks pass: vision, personas, feature specs (Feature + Enabler types), journeys with AC cross-references, UX/UI designs, design system, manifest",
      "assertions": [
        { "type": "exit_code", "value": 0, "description": "Validation script exits cleanly" },
        { "type": "output_contains", "value": "0 failed", "description": "Zero failures in output" },
        { "type": "output_contains", "value": "PASS", "description": "At least one PASS in output" }
      ]
    },
    {
      "id": 2,
      "suite": "progressive-narrowing",
      "prompt": "Generate a health check endpoint 3 times with no svc phases (just a one-line prompt) and 3 times with full pipeline (spec → tech design → code). Measure pairwise diff variance between the 3 outputs in each group.",
      "expected_output": "Full-pipeline group has lower pairwise diff variance than no-phases group, demonstrating that progressive narrowing reduces implementation variance",
      "assertions": [
        { "type": "metric_comparison", "metric": "variance_lines", "condition": "full_pipeline < no_phases", "description": "Full pipeline produces less variance" }
      ]
    },
    {
      "id": 3,
      "suite": "review-gate",
      "prompt": "Take the todo-api feature spec and plant 5 known errors (contradicting AC, nonexistent file reference, ungrounded precondition, compound story, untestable AC). Run single-pass review and full review protocol. Count how many errors each approach finds.",
      "expected_output": "Full review protocol finds more planted errors than single-pass review",
      "assertions": [
        { "type": "metric_comparison", "metric": "errors_found", "condition": "full_protocol >= single_pass", "description": "Protocol finds at least as many errors" },
        { "type": "metric_threshold", "metric": "full_protocol_errors_found", "condition": ">= 4", "description": "Protocol finds at least 4 of 5 planted errors" }
      ]
    }
  ]
}
