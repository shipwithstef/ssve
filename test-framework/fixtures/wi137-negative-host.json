{
  "host": "claude",
  "name": "Claude Code",
  "skills_path": "~/.claude/skills",
  "rules_path": "~/.claude/rules",
  "builder_profile_path": "~/.svc/builder-profile.md",
  "capabilities": {
    "skills": true,
    "hooks": true,
    "plugins": true,
    "mcp": true,
    "commands": true,
    "agents": true
  },
  "hook_events": [
    "SessionStart",
    "SessionEnd",
    "InstructionsLoaded",
    "UserPromptSubmit",
    "UserPromptExpansion",
    "PreToolUse",
    "PermissionRequest",
    "PermissionDenied",
    "PostToolUse",
    "PostToolUseFailure",
    "PostToolBatch",
    "SubagentStart",
    "SubagentStop",
    "TaskCreated",
    "TaskCompleted",
    "Stop",
    "StopFailure",
    "ConfigChange",
    "CwdChanged",
    "FileChanged",
    "WorktreeCreate",
    "WorktreeRemove",
    "PreCompact",
    "PostCompact",
    "Elicitation",
    "ElicitationResult",
    "Notification",
    "TeammateIdle"
  ],
  "hook_quirks": {
    "timeout_unit": "s",
    "timeout_default_command": 600,
    "timeout_default_http": 30,
    "config_file": "~/.claude/settings.json",
    "tool_matcher_regex": true,
    "hook_types": [
      "command",
      "http",
      "mcp_tool",
      "prompt",
      "agent"
    ],
    "decision_format": "hookSpecificOutput.permissionDecision",
    "async_supported": true,
    "env_vars": [
      "CLAUDE_PROJECT_DIR",
      "CLAUDE_PLUGIN_ROOT",
      "CLAUDE_PLUGIN_DATA",
      "CLAUDE_ENV_FILE",
      "CLAUDE_CODE_REMOTE"
    ]
  },
  "task_graph": {
    "task_ui": "TaskList/TaskUpdate",
    "background_tasks": false,
    "skill_load_mode": "skill_tool",
    "native_task_read_tools": [
      "TaskList"
    ]
  },
  "infra_files": [
    "DOCTRINE.md",
    "REPO_MODES.md",
    "WORKTREES.md",
    "EXTERNAL_ADDONS.md",
    "FRAMEWORK-STATE.md",
    "skills-manifest.json",
    "CONTRIBUTING.md"
  ],
  "infra_dirs": [
    "scripts",
    "references",
    "proposals",
    "examples",
    "hooks",
    "provision",
    "templates"
  ],
  "skip": [],
  "post_install_commands": [
    "bash {skills_path}/scripts/install-browse.sh"
  ],
  "verify_commands": [
    "test -f {skills_path}/route-workflow/SKILL.md",
    "test -f {skills_path}/DOCTRINE.md",
    "test -f {skills_path}/skills-manifest.json",
    "test -f {skills_path}/scripts/worktree.sh",
    "test -f {skills_path}/scripts/install-browse.sh",
    "$HOME/gstack/browse/dist/browse status 2>&1 | grep -q 'Status: healthy'"
  ]
}
