        "reverse-engineer",
        "audit-coverage",
        "platform-operating-architect",
        "evaluate-rule",
        "launch-knowledge"
      ],
      "start_from": [
        "FRAMEWORK-STATE.md",
        "skills-manifest.json",
        "active-WI"
      ],
      "dependency_expansion": [
        "affected-SKILL.md",
        "affected-hook-or-script",
        "host-wirer",
        "tier-1-validator",
        "review-source"
      ],
      "stop_condition": "Stop after the affected framework surface, host wiring, and validator coverage are all represented."
    },
    {
