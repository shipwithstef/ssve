      ],
      "start_from": [
        "session-contract",
        "user-request",
        "work-item-index",
        "spec-index"
      ],
      "dependency_expansion": [
        "referenced-proposal",
        "source-review",
        "related-WIs",
        "decision-log"
      ],
      "stop_condition": "Stop after the route, advice, or state mutation has enough linked evidence to avoid skipping a mandatory branch."
    },
    {
      "id": "framework-evolution",
      "skills": [
        "define-code-style",
        "capability-registry",
        "capability-concierge",
        "test-framework",
        "audit-session-execution",
        "evolve-framework",
        "blend-external",
        "blend-private",
        "create-skill",
