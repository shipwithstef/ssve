{
  "version": 1,
  "purpose": "Family-level Before Starting coverage for legacy first-party svc skills.",
  "rules": [
    "New skills authored on or after 2026-04-28 still need an explicit ## Before Starting section.",
    "Legacy skills without a direct section are covered by exactly one family here until they are substantively edited.",
    "Every family must define how to reach complete relevant context without bulk-reading unrelated artifacts."
  ],
  "families": [
    {
      "id": "product-definition",
      "skills": [
        "write-vision",
        "analyze-domain",
        "analyze-competitors",
        "refresh-competitors",
        "catalog-domain-capabilities",
        "build-personas",
        "write-journeys",
        "test-journeys",
        "validate-feature",
        "write-spec"
      ],
      "start_from": [
        "session-contract",
        "builder-profile",
        "project-state"
      ],
      "dependency_expansion": [
        "domain-profile",
        "feature-spec",
        "journey-index",
        "related-work-items"
      ],
      "stop_condition": "Stop after all related feature, journey, domain, and AC sources that can change the product contract are loaded."
    },
    {
      "id": "planning-and-execution",
      "skills": [
        "craft-prompt", "blind-control-plan", "design-ux",
        "design-ui",
        "design-logo",
        "design-tech",
        "explore-solutions",
        "explore-ux",
        "plan-changeset",
        "execute-changeset",
        "write-e2e",
        "review-gate",
        "audit-implementation",
        "land-changeset",
        "verify-promotion",
        "review-cross-model",
        "review-plan",
        "track-visuals",
        "review-security",
        "plan-blast-radius",
        "track-topology-diff",
        "review-exec"
      ],
      "start_from": [
        "active-WI",
        "task-graph",
        "approved-plan"
      ],
      "dependency_expansion": [
        "active-spec",
        "journeys",
        "review-findings",
        "validators",
        "worktree-state"
      ],
      "stop_condition": "Stop after all contracts and validators governing the planned edit, evidence, and merge surface are loaded."
    },
    {
      "id": "routing-and-state",
      "skills": [
        "route-workflow",
        "capture-idea",
        "audit-ac",
        "sync-spec-code",
        "onboard-repo",
        "diagnose-bug",
        "align-feature",
        "audit-feature",
        "decide",
