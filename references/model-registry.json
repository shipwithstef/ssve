{
 "$schema": "https://github.com/s7an-it/seriousvibecoding/schemas/model-registry.json",
 "description": "Host-agnostic model registry for Serious Vibe Coding. Separates orchestrator (who runs the session) from execution harness (which model handles each cognitive label). Skills reference cognitive labels; the framework resolves them via the active profile.",
 "version": 2,
 "externalReviewPolicy": {
  "version": 3,
  "cutover_utc": "2026-07-19T21:00:00Z",
  "cutover_local": "2026-07-20 00:00:00 EEST",
  "timezone": "Europe/Sofia",
  "selection": {
   "schema_version": 1,
   "path": ".svc/external-review-policy/v1/selection.json",
   "authority": "repository-owner",
   "applies_to_orchestrator": "codex",
   "allowed_profiles": ["fable-high"]
  },
  "orchestrators": {
   "claude": {
    "profile": "codex-high",
    "source": "fixed-policy"
   },
   "codex": {
    "schedule": [
     { "profile": "fable-high", "starts_at": null, "ends_at": "2026-07-19T21:00:00Z" },
     { "profile": "opus-high", "starts_at": "2026-07-19T21:00:00Z", "ends_at": null }
    ]
   }
  },
  "profiles": {
   "codex-high": {
    "tuple": { "orchestrator": "claude", "host": "codex", "family": "openai", "model": "gpt-5.6-sol", "effort": "high" },
    "fallback": null
   },
   "fable-high": {
    "tuple": { "orchestrator": "codex", "host": "claude", "family": "anthropic", "model": "claude-fable-5", "effort": "high" },
    "fallback": {
     "tuple": { "orchestrator": "codex", "host": "claude", "family": "anthropic", "model": "claude-opus-4-8", "effort": "xhigh" },
     "eligible_after": ["model_unavailable", "model_entitlement", "provider_overload"]
    }
   },
   "opus-high": {
    "tuple": { "orchestrator": "codex", "host": "claude", "family": "anthropic", "model": "claude-opus-4-8", "effort": "high" },
    "fallback": null
   }
  }
 },
 "cognitiveLabels": {
  "STRAT": {
   "description": "Strategic Determination — high-stakes decisions, product invention, spatial UX reasoning, resolving ambiguity",
   "icon": "🧠",
   "useFor": "Strategic decisions, architecture, north-star definition"
  },
  "PLAN": {
   "description": "Architectural Blueprinting — dependency graphs, JSON manifests, task logic, strict planning",
   "icon": "📐",
   "useFor": "Blueprinting, dependency graphs, manifest creation"
  },
  "EXEC": {
   "description": "Agentic Execution — high-volume file editing, terminal commands, running tests, bash loops",
   "icon": "⚙️",
   "useFor": "File edits, bash commands, tests, execution"
  },
  "REVIEW": {
   "description": "Grounded Verification — code review, architectural drift detection, spec alignment",
   "icon": "🛡️",
   "useFor": "Code review, drift detection, spec alignment"
  },
  "SENSE": {
   "description": "Temporal / Sensory QA — video, UI animations, audio interactions, visual regression",
   "icon": "👁️",
   "useFor": "Video, UI animations, visual regression"
  },
  "DISC": {
   "description": "Grounded Discovery — live docs, competitor pages, exact SDK versions, web search",
   "icon": "🌐",
   "useFor": "Web search, live docs, competitor research"
  },
  "PASS": {
   "description": "Pass-Through Distillation — mechanical extraction, reformatting, no reasoning needed",
   "icon": "🔁",
   "useFor": "Mechanical extraction, reformatting, no reasoning"
  }
 },
 "orchestrators": {
  "claude": {
