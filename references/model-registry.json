 "profiles": {
  "svc-default": {
   "description": "Framework default. Claude orchestrates + Sonnet executes + MiMo-V2.5-Pro senses (key-gated). Updated 2026-06-06 (WI-357): EXEC moved mimo→claude/sonnet to match the operative dispatch-preflight fallback (MIMO_API_KEY-gated) and review-grade execution quality; MiMo execution remains first-class via opencode-mimo / kimi-orchestrator-mixed profiles.",
   "labels": {
    "STRAT": {
     "harness": "claude",
     "model": "opus",
     "rationale": "Highest reasoning depth for strategy"
    },
    "PLAN": {
     "harness": "claude",
     "model": "opus",
     "rationale": "Deterministic blueprinting needs frontier reasoning",
     "displayRationale": "Deterministic blueprinting"
    },
    "EXEC": {
     "harness": "claude",
     "model": "sonnet-5",
     "effort": "high",
     "rationale": "WI-470 2026-06-30: EXEC runs on Sonnet 5 (subagents pinned). effort:high is DECLARED here (output_config.effort:high, claude-api-verified, adaptive thinking) and surfaced via resolve-model EXEC --effort; consumers apply it via the Agent dispatch effort param (this is the routing source, not the applier). Supersedes WI-357 EXEC=Sonnet4.6; MiMo EXEC via opencode-mimo/kimi profiles",
     "displayRationale": "Sonnet 5 execution; effort:high declared (WI-470); MiMo EXEC via keyed profiles"
    },
    "REVIEW": {
     "harness": "claude",
     "model": "sonnet-5",
     "effort": "high",
     "rationale": "WI-470 2026-06-30: REVIEW runs on Sonnet 5 (subagents pinned) against the Opus blueprint; effort:high declared here, consumer-applied via the Agent dispatch effort param"
    },
    "SENSE": {
     "harness": "mimo",
     "model": "mimo-v2.5-pro",
     "rationale": "Multimodal (text+image) sensory QA; V2.5-Pro supersedes V2-Omni with 57.2% SWE-bench Pro. Requires MIMO_API_KEY; without it dispatch preflight falls back per execute-changeset",
     "displayRationale": "Multimodal sensory QA (requires MIMO_API_KEY)"
    },
    "DISC": {
     "harness": "native",
     "tool": "web_search",
     "rationale": "Live docs via native search"
    },
    "PASS": {
     "harness": "claude",
     "model": "haiku",
     "rationale": "Cheapest pass-through extraction"
