knowledge our Privacy Policy, available at \u003clink\u003eelevenlabs.io/privacy-policy\u003c/link\u003e\",\"data_sharing_consent\":\"You consent to the sharing of your data with third-parties as may be necessary to provide this service to you\",\"cancel_button\":\"Cancel\",\"agree_button\":\"I agree\"}},\"hero_agent\":{\"defaults\":{\"primary_button\":\"Sign up free\",\"secondary_button\":\"Talk to Sales\",\"call_agent_button\":\"Call Agent\",\"get_call_button\":\"Get a call\"},\"views\":{\"agent_info\":{\"initial_message\":\"Hey there! How can I...\",\"call_agent\":\"Call Agent\",\"get_call\":\"Get a call\",\"end_call\":\"End call\"},\"request_call\":{\"title\":\"Receive a live call from an Agent\",\"subtitle\":\"Leave the details below to have the Agent call you directly on your mobile phone.\",\"name_label\":\"Name\",\"name_placeholder\":\"John\",\"phone_label\":\"Phone number\",\"phone_placeholder\":\"123 456 7890\",\"select_country\":\"Select country code\",\"search_countries\":\"Search countries\",\"no_countries_found\":\"No countries found\",\"consent_text\":\"I consent to the recording, storage and sharing of my communications as described by the \u003ctermsLink\u003eTerms of Service\u003c/termsLink\u003e and \u003cprivacyLink\u003ePrivacy Policy\u003c/privacyLink\u003e. I agree to receive a one-time verification text. Msg \u0026 data rates may apply.\",\"get_call_button\":\"Get a call\",\"cancel\":\"Cancel\",\"errors\":{\"default\":\"Something went wrong. Please try again.\"}},\"verify_phone\":{\"title\":\"Verify your phone number\",\"subtitle\":\"Please enter the code we sent to your phone number\",\"code_label\":\"Verification code\",\"didnt_get_code\":\"Didn't get the code?\",\"resend_now\":\"Resend now\",\"resend_in\":\"Resend in {seconds}s\",\"max_attempts_reached\":\"Max attempts reached\",\"get_call_button\":\"Get a call\",\"back\":\"Go back\",\"errors\":{\"invaid_verification_code\":\"Invalid verification code. Please try again. {attempts} attempts remaining.\"}},\"conversation\":{\"languages\":\"Languages\",\"mute\":\"Mute\",\"unmute\":\"Unmute\",\"end_call\":\"End call\",\"connecting\":\"Connecting...\",\"disconnected\":\"Disconnected\",\"error_connecting\":\"An error occurred while connecting. Please try again.\",\"agent_description\":\"Your ElevenLabs Agent\"},\"call_scheduled\":{\"title\":\"Call scheduled!\",\"subtitle\":\"You'll receive a call from the agent within the next couple of minutes.\",\"didnt_get_call\":\"Didn't get the call?\",\"resend_in\":\"Resend in {seconds}s\",\"resend_now\":\"Resend now\",\"close\":\"Close\",\"max_attempts_reached\":\"Max attempts reached\"}},\"call_agent_title\":\"Start a live call with an Agent\",\"call_agent_consent_text\":\"By clicking 'Agree' and each time I interact with this AI agent, I consent to the recording, storage, and sharing of my communications with third-party service providers, as described in the \u003ctermsLink\u003eTerms of Service\u003c/termsLink\u003e and \u003cprivacyLink\u003ePrivacy Policy\u003c/privacyLink\u003e. If you do not wish to have your conversations recorded, please refrain from using this service.\",\"agree\":\"Agree\",\"cancel\":\"Cancel\",\"switcher\":{\"chat\":\"Chat\",\"voice\":\"Voice\"}},\"video_rotation_demo\":{\"tap_to_show_controls\":\"Tap to show video controls\",\"play_video\":\"Play {title}\"},\"CaseStudiesGrid\":{\"filter_by_industry\":\"Filter by industry\",\"no_case_studies_found\":\"No case studies found matching selected filters\"},\"music_share_page\":{\"embed_player\":{\"title\":\"{title} - ElevenLabs Music Player\"}},\"ConvAiSupportAgent\":{\"terms_and_conditions\":\"Terms and conditions\",\"terms_and_conditions_description\":\"By clicking 'Agree' and each time I interact with this AI agent, I consent to the recording, storage, and sharing of my communications with third-party service providers, and as described in the Privacy Policy. If you do not wish to have your conversations recorded, please refrain from using this service.\",\"voice_chat\":\"Voice chat\",\"chat\":\"Chat\",\"powered_by_elevenlabs\":\"Powered by ElevenLabs\",\"conversational_ai\":\"Agents\",\"was_the_call_helpful\":\"Was the call helpful?\",\"connecting\":\"Connecting...\",\"end_call\":\"End call\",\"agree\":\"Agree\",\"cancel\":\"Cancel\",\"start_call\":\"Start call\"},\"IntegrationsGrid\":{\"integration_alt\":\"Integrate ElevenLabs Agents with {title}\"},\"BentoGrid\":{\"VideoScroller\":{\"click_to_play\":\"{title} - Click to play\",\"playing_click_to_pause\":\"{title} (playing) - Click to pause\",\"video_label\":\"{title} video\"},\"TTSControls\":{\"paragraph_1_text_1\":\"The voice paused for a moment, \",\"paragraph_1_tag\":\"[softly]\",\"paragraph_1_text_2\":\" as if gathering its thoughts before continuing. Every breath felt intentional, every hesitation perfectly timed.\",\"paragraph_2_text_1\":\"This wasn't synthetic speech anymore \",\"paragraph_2_tag\":\"[laughs warmly]\",\"paragraph_2_text_2\":\" - it was a voice that understood timing, emotion, and the space between words.\",\"paragraph_3_text_1\":\"Text transformed into presence. \",\"paragraph_3_tag\":\"[sighs contentedly]\",\"paragraph_3_text_2\":\" Words given life, personality, soul.\",\"slider_speed\":\"Speed\",\"slider_tone\":\"Tone\",\"slider_pacing\":\"Pacing\",\"slider_style_exaggeration\":\"Style Exaggeration\",\"aria_label\":\"UI example of text-to-speech controls with voice selection, model selection, and audio parameter sliders.\"},\"VoiceClone\":{\"title\":\"My cloned voice\",\"button_upload_samples\":\"Upload samples\",\"button_record_yourself\":\"Record yourself\",\"attribute_language\":\"Language\",\"attribute_language_value\":\"English\",\"attribute_accent\":\"Accent\",\"attribute_accent_value\":\"Canadian\",\"attribute_gender\":\"Gender\",\"attribute_gender_value\":\"Female\",\"attribute_age\":\"Age\",\"attribute_age_value\":\"Young\",\"aria_label\":\"UI example of voice cloning interface with upload and record options, di