5, 255, 255, 0.74074) 35.26%, rgba(255, 255, 255, 0.648) 41.25%, rgba(255, 255, 255, 0.54993) 47.1%, rgba(255, 255, 255, 0.45007) 52.9%, rgba(255, 255, 255, 0.352) 58.75%, rgba(255, 255, 255, 0.25926) 64.74%, rgba(255, 255, 255, 0.17541) 70.96%, rgba(255, 255, 255, 0.104) 77.5%, rgba(255, 255, 255, 0.04859) 84.46%, rgba(255, 255, 255, 0.01274) 91.93%, rgba(255, 255, 255, 0) 100%)"></div><pre style="font-variant-ligatures:none" class="[&amp;_code]:tw-font-mono [&amp;_code]:tw-block tw-text-2xs/[1.375rem] tw-text-black"><code><span style="color:#F41A2F">import</span> { ElevenLabsClient } <span style="color:#F41A2F">from</span><span style="color:#052F70"> "@elevenlabs/elevenlabs-js"</span>;

