nvert(\",\"$undefined\"]],[[\"  \",\"$undefined\"],[\"voice_id\",\"#0A59D2\"],[\"=\",\"$undefined\"],[\"\\\"__VOICE__\\\"\",\"#052F70\"],[\",\",\"$undefined\"]],[[\"  \",\"$undefined\"],[\"text\",\"#0A59D2\"],[\"=\",\"$undefined\"],[\"\\\"__TEXT__\\\"\",\"#052F70\"],[\",\",\"$undefined\"]],[[\"  \",\"$undefined\"],[\"model_id\",\"#0A59D2\"],[\"=\",\"$undefined\"],[\"\\\"eleven_v3\\\"\",\"#052F70\"],[\",\",\"$undefined\"]],[[\"  \",\"$undefined\"],[\"language_code\",\"#0A59D2\"],[\"=\",\"$undefined\"],[\"\\\"__LANGUAGE__\\\"\",\"#052F70\"],[\",\",\"$undefined\"]],[[\")\",\"$undefined\"]]]}}}]\n"])</script></body></html>