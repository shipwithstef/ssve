ews Publishers\",\"non_profit_organizations\":\"Non-profit Organizations\",\"other\":\"Other\",\"professional_training_coaching\":\"Professional Training \u0026 Coaching\",\"public_education\":\"Public Education\",\"retail\":\"Retail\",\"sports\":\"Sports\",\"staffing_recruiting\":\"Staffing \u0026 Recruiting\",\"telecommunications\":\"Telecommunications\",\"tv_radio_broadcasting\":\"TV \u0026 Radio Broadcasting\"},\"company_size\":{\"less_than_100\":\"\u003c 100\",\"100_to_500\":\"100-500\",\"more_than_500\":\"\u003e 500\"},\"expected_monthly_usage\":{\"over_100k_minutes\":\"Over 100,000 minutes of audio (\u003e 100M characters)\",\"over_10k_minutes\":\"Over 10,000 minutes of audio (\u003e 10M characters)\",\"under_10k_minutes\":\"Less than 10,000 minutes of audio, but am curious about Enterprise plans.\",\"not_relevant\":\"Not relevant - I need help with a question or issue\"},\"platform_interest\":{\"eleven_agents\":\"ElevenAgents\",\"eleven_creative\":\"ElevenCreative\",\"eleven_api\":\"ElevenAPI\"}},\"buttons\":{\"continue\":\"Continue\",\"back\":\"Back\",\"next\":\"Next\",\"go_back\":\"Go back\",\"submit\":\"Submit Form\"},\"errors\":{\"captcha_failed\":\"Security verification failed. Please try again.\",\"submission_failed\":\"Failed to submit form. Please try again.\",\"validation_failed\":\"Please check your information and try again.\",\"rate_limit\":\"Too many requests. Please wait a moment and try again.\",\"unknown_error\":\"Something went wrong. Please try again later.\",\"server_error\":\"Server error. Please try again later.\"},\"resume_prompt\":{\"message\":\"Pick up where you left off?\",\"continue_button\":\"Continue\",\"start_fresh_button\":\"Start Fresh\"},\"empty_states\":{\"no_countries_found\":\"No countries found\",\"no_results_found\":\"No results found\",\"loading_countries\":\"Loading countries...\"},\"tooltips\":{\"country_hq_helper\":\"Select the country you operate from, not your HQ\"},\"placeholders\":{\"search_countries\":\"Search countries...\",\"search\":\"Search...\"},\"labels\":{\"optional\":\"Optional\"}},\"trusted_by_businesses\":\"Trusted by 10,000+ leading businesses\",\"g2_reviews\":\"4.5 stars and 1,059+ reviews\"},\"Globals\":{\"learn_more\":\"Learn more\",\"sign_up\":\"Sign up\",\"sign_in\":\"Log in\",\"log_in_with_google\":\"Log in with Google\",\"oauth_cta_microcopy\":\"Trusted by 1M+ users • Free to start\",\"play\":\"Play\",\"play_item\":\"Play \\\"{title}\\\"\",\"pause\":\"Pause\",\"pause_item\":\"Pause \\\"{title}\\\"\",\"resume\":\"Resume\",\"mute\":\"Mute\",\"unmute\":\"Unmute\",\"input\":\"Input\",\"output\":\"Output\",\"allPricing\":\"All pricing\",\"back\":\"Back\",\"footer\":\"Footer\",\"menu\":\"Menu\",\"GDPR\":\"GDPR\",\"loading\":\"Loading...\",\"moreStories\":\"More stories\",\"watch_video\":\"Watch video\",\"watch_full_video\":\"Watch full video\",\"Start recording\":\"Start recording\",\"Use cases\":\"Use cases\",\"pre_footer\":{\"text\":\"Already have an account?\",\"title\":\"Everything you need to create sound\"},\"seeMore\":\"See more\",\"select\":{\"default_placeholder\":\"Select items\",\"selected_count\":\"{count} selected\"},\"share\":{\"copyLink\":\"Copy link to share\",\"copyLinkSuccess\":\"Link copied to clipboard\",\"twitter\":\"Share on X\",\"linkedin\":\"Share on LinkedIn\",\"facebook\":\"Share on Facebook\"},\"view_more\":\"View more\",\"view_less\":\"View less\",\"watchFilm\":\"Watch film\",\"experience_full_audio_platform\":\"Experience the full Audio AI platform\",\"navigation\":{\"open\":\"Open main navigation\",\"close\":\"Close main navigation\",\"open_secondary\":\"Open {platform} navigation\",\"close_secondary\":\"Close {platform} navigation\",\"cta\":{\"label\":\"Sign up\"},\"brand\":{\"menuLabel\":\"ElevenLabs brand assets\",\"copyLogoLabel\":\"ElevenLabs logo\",\"copySymbolLabel\":\"ElevenLabs symbol\",\"downloadSvg\":\"Download as .svg\",\"downloadPng\":\"Download as .png\",\"brand\":\"Brand\",\"brandGuidelines\":\"Brand guidelines\"}},\"sample_button\":{\"text\":\"Try a sample\"},\"try_for_free\":\"Try for free\",\"missing_template\":\"Missing template\",\"block_type\":\"Block: {blockType}\",\"block_error_title\":\"This section didn't load\",\"block_error_description\":\"Try reloading the page to fix it\",\"block_error_reload\":\"Reload page\",\"cancel\":\"Cancel\",\"elevenlabs_cms\":\"ElevenLabs CMS\",\"next_slide\":\"Next slide\",\"previous_slide\":\"Previous slide\",\"download\":\"Download\",\"downloads\":\"Downloads\",\"loop\":\"Loop\",\"no_loop\":\"No Loop\",\"sound_effects\":\"sound effects\",\"clear_search\":\"Clear search\",\"close\":\"Close\",\"invalid_icon\":\"The icon name is not valid\",\"elevenlabs\":\"ElevenLabs\",\"more_pages\":\"More pages\",\"pagination\":\"Pagination\",\"here\":\"here\",\"restart\":\"Restart\",\"next\":\"Next\",\"previous\":\"Previous\",\"copyright\":\"© {year} ElevenLabs\",\"copyright_v2\":\"All rights reserved © {year}\",\"select_language\":\"Select language\",\"Load More\":\"Load More\",\"copy\":\"Copy\",\"copied\":\"Copied\",\"share_article\":\"Share article\",\"default_alt_text\":\"ElevenLabs cover image\",\"scroll_to_explore\":\"Scroll to explore\",\"click_to_play\":\"Click a sample to play\",\"contact_sales\":\"Contact sales\",\"share_label\":\"Share\",\"edit_prompt_label\":\"Edit prompt\",\"tracks\":\"tracks\"},\"v3\":{\"heading\":{\"content\":\"Meet Eleven v3. \u003cbr /\u003e Our most expressive AI voice model.\"},\"globe\":{\"title\":\"Human-like speech in 70+ languages\",\"description\":\"Reach global audiences with expressive and nuanced speech in every major language.\",\"click_to_preview\":\"Click to preview\",\"languages\":{\"english\":\"English\",\"portuguese\":\"Portuguese\",\"chinese\":\"Chinese\",\"spanish\":\"Spanish\",\"french\":\"French\",\"german\":\"German\",\"japanese\":\"Japanese\",\"italian\":\"Italian\",\"hindi\":\"Hindi\"}}},\"SoundEffectCategories\":{\"search\":{\"placeholder\":\"Search sound effects…\",\"ariaLabel\":\"Search sound effects categories\",\"suggestionsLabel\":\"Similar:\",\"loading\":\"Searching…\",\"no_results\":\"No results found\"},\"popover\":{\"weather\":\"Weather\",\"activeTrackTitle\":\"Thunder and lightning\",\"inactiveTrackTitle\":\"Wind blast\"},\"inlineGenerator\":{\"scrollAnnouncement\":\"Sound effect generator\"}},\"SignUp\":{\"sign_up_experience\":\"Sign up and experience full audio platform\",\"sign_up_description\":\"Imagine a sound and bring it to life, or download a selection of the best sound effects generated by the community.\",\"sign_up_for_free\":\"Sign up for free\"},\"music\":{\"hero\":{\"hero_title\":\"Introducing Eleven AI Music Generator\",\"hero_description\":\"Generate studio-quality tracks instantly, any genre, any style, vocals or instrumental, in minutes using simple text prompts.\",\"get_started\":\"Get Started\",\"track_descriptions\":{\"0\":\"Slow, dreamy indie rock with reverb vocals, retro keys, and phased guitars\",\"1\":\"Slow latin reggaeton with charismatic Spanish MC, dancehall vibes\",\"2\":\"Conscious hip hop with jazzy beats, sharp transients, and experimental flow\",\"3\":\"Dreamy slow indie rock with reverb vocals, phased guitars, and nostalgic vibe\",\"4\":\"Cinematic wild west track with twangy guitars and epic orchestral finale\",\"5\":\"Modern Afrobeats with deep bass, smooth male vocals, and sensual groove, 95bpm\",\"6\":\"Dreamy slow indie rock with reverb vocals, retro keys, and phased guitars\",\"7\":\"Traditional flamenco with passionate vocals and expressive Andalusian guitar\",\"8\":\"Moody reggae with soulful male vocals, deep bass, and haunting keys\",\"9\":\"Retro 1950s track with crooner vocals, vintage charm, and nostalgic hooks\",\"10\":\"Epic cinematic choir with grand orchestration and a triumphant crescendo\",\"11\":\"Ethereal modern pop with soft female vocals and warm nostalgic synths\",\"12\":\"Dark, moody jazz with haunting female vocals and sparse, slow instrumentation\"}}},\"conversational_ai_page\":{\"languages_overview\":{\"title\":\"Global by default and human at every turn\",\"section_title\":\"Human-like \u0026 Multilingual\",\"description\":\"Support global audiences with automatic language detection, multilingual voice synthesis, and real-time switching powered by advanced turn-taking.\",\"quote\":{\"text\":\"\\\"The introduction of a voice has transformed our app, it brought a whole new dimension to learning chess online\\\"\",\"author\":\"Gabe Jacobs\",\"title\":\"Product Manager at Chess.com\"},\"items\":{\"automatic_language_detection\":{\"title\":\"Automatic language detection and switch\",\"description\":\"Agents can detect and switch languages in real time based on what the user says. No setup or manual input required. Ideal for global support lines, travel, retail, and more.\"},\"voices_selection\":{\"title\":\"1000+ voices to choose from\",\"description\":\"Choose from a wide selection of expressive voices across accents, styles, and languages. All voices are optimized for clarity, realism, and low-latency performance in live conversations.\"},\"turn_taking_model\":{\"title\":\"State of the art turn-taking model\",\"description\":\"Conversations flow naturally thanks to real-time detection of pauses, overlaps, and speech intent. Agents know when to listen and when to speak — even when users interrupt or hesitate.\"}},\"languages_selector\":{\"view_all_languages\":\"View all supported languages\",\"supported_languages_count\":\"View 32 supported languages\",\"modal_title\":\"Talk to customers in 32 languages, and counting\",\"all_supported_languages\":\"All supported languages\",\"close\":\"Close\"}},\"floating_agent\":{\"talk_to_agent\":\"Talk to an agent\",\"agent_name\":\"Eleven\",\"agent_title\":\"Your ElevenLabs assistant\",\"change_language\":\"Change language\",\"mute\":\"Mute\",\"unmute\":\"Unmute\",\"end_call_description\":\"Discover the capabilities of Conversational Agents powered by ElevenLabs\",\"loading\":\"Loading...\"},\"demo_scripts\":{\"enter_message\":\"Enter your message\",\"order_status\":{\"user_messages\":{\"check_order\":\"Hello, can I check my order status?\",\"yes_tracking\":\"Yes, that would be great\",\"thanks\":\"Awesome, thanks!\"},\"assistant_messages\":{\"checking_order\":\"Let me check your order status...\",\"loading_checking\":\"Checking order status...\",\"order_result\":\"Your order is on its way with FedEx! It should arrive tomorrow by 8pm.\",\"ask_tracking\":\"Would you like me to text you the tracking link?\",\"sending_tracking\":\"Sending tracking link...\",\"tracking_sent\":\"Done! I've just sent the tracking link to the phone number ending in 9042.\"}},\"appointment_booking\":{\"user_messages\":{\"book_appointment\":\"Hi, I'd like to book an appointment\",\"confirm_time\":\"10:30 is good, thanks\",\"thanks\":\"Thanks! I'll see you then\"},\"assistant_messages\":{\"checking_availability\":\"Let me check for openings...\",\"loading_availability\":\"Checking availability...\",\"availability_result\":\"Sure, would Thursday at 9:00am and 10:30am work?\",\"scheduling\":\"Let me schedule your appointment...\",\"loading_booking\":\"Booking appointment...\",\"booking_confirmed\":\"Great! We're all set for 10:30am on Thursday.\"}},\"customer_support\":{\"user_messages\":{\"computer_frozen\":\"Hey, my computer is frozen\",\"thanks\":\"Yeah, it's back up and running! Thank you so much!\"},\"assistant_messages\":{\"greeting\":\"Hi Robert — I've got you. Now let me pull up your device.\",\"checking_device\":\"Checking device status...\",\"loading_lookup\":\"Looking up user by phone...\",\"solution\":\"Got it! Let's just try a hard reboot by holding the power button for 3 seconds.\",\"goodbye\":\"You're very welcome, sir. Have a great day.\"}}}},\"hero_voice_design\":{\"prompt\":\"Prompt\",\"text_to_preview\":\"Text to preview\",\"voice_design_intro\":{\"title\":\"Introducing Voice Design, powered by our latest Text to Speech v3 model.\",\"description\":\"Create lifelike voices from any description - surreal to serious, funny to fierce. Voice any character and bring your stories to life.\"},\"samples\":{\"warrior\":{\"previewText\":\"Arigatō, Elevenlabs.\\nMy Blade is ready.\",\"prompt\":\"A calm and husky make warrior with a thick Japanese accent. Soft, whiskery, low tone with a composed and gentle pacing.\"},\"witch\":{\"previewText\":\"[menacing laugh] This could be the final ingredient!\",\"prompt\":\"A scary old and haggard witch who is sneaky and menacing. She has a croaky, harsh, shrill, high-pitch voice that cackles.\"},\"spy\":{\"previewText\":\"[slight French accent] This… is strictly confidential.\",\"prompt\":\"A low, whispery and assertive female voice with a thick French accent. Cool, composed and seductive, with a hint of mystery.\"},\"alien\":{\"previewText\":\"Greetings, earthlings. I must say your voice models are out of this world!\",\"prompt\":\"A funny alien from outer space with a ludicrous and annoying voice that always slightly gargles in a silly high-pitch tone.\"},\"nana\":{\"previewText\":\"[cranky] Back in my day we didn't need all these fancy gadgets.\",\"prompt\":\"A very old, cranky and croaky African-American grandma. 80 years old. Very hoarse, grumpy, shrill and frustrated.\"},\"cowboy\":{\"previewText\":\"Well, I'll be damned. [laughs] Looks like it's just me and you left. Ain't seen Bodecker since back at Old Ford and... Ah, hell. Let's head back to camp before the dark sets in.\",\"prompt\":\"A calm, tough and gruff old cowboy with an deep, gravelly, southern American accent.\"},\"zeus\":{\"previewText\":\"[ethereal music] Greetings, my friend. What brings you to Mount Olympus today? Here to gaze at my beautiful muscles again?\",\"prompt\":\"The friendly mythical God, Zeus, with a huge deep powerful voice. Charming, proud, strong and theatrical.\"}},\"cta\":{\"label\":\"Try Voice Design v3\",\"description\":\"Create any character imaginable with Voice Design v3.\\n Available now on ElevenLabs, free to start.\",\"buttonLabel\":\"Sign up\"}},\"VoicesSlider\":{\"use_voice\":\"Use Voice\",\"explore_all_voices\":\"Explore All Voices\",\"explore_voice_library\":\"Explore all 10,000+ Voices\",\"previous_voice\":\"Previous voice\",\"next_voice\":\"Next voice\"},\"Blog\":{\"last_updated\":\"Last updated \",\"readingTime\":\"{minutes, plural, one {# minute reading time} other {# minutes reading time}}\",\"allCategories\":\"Featured\"},\"soundboard\":{\"preset_editor\":{\"title\":\"Editing\",\"subtitle\":\"Configure\",\"name_label\":\"Preset Name\",\"name_placeholder\":\"Enter preset name\",\"save_preset\":\"Save preset\",\"update_preset\":\"Update preset\",\"create_account_to_save_preset\":\"Create an account to save your preset and share it with others. Without an account, your preset will only be available during this session.\",\"create_account\":\"Create account\",\"share_preset\":\"Share preset\",\"share_link_copied\":\"Share link copied to clipboard\",\"preset_created\":\"Preset was created successfully\",\"preset_updated\":\"Preset was updated successfully\",\"preset_deleted\":\"Preset was deleted successfully\"},\"sound_effect_editor\":{\"title\":\"Describe your sound effect\",\"subtitle\":\"Generate sound effects\",\"description_placeholder\":\"A devastating explosion with high reverb\\nA highly compressed snare drum being hit very hard once\\nWhale song heard from underwater\",\"generate\":\"Generate\",\"generating\":\"Generating...\",\"generated_sounds\":\"Generated Sound Effects\",\"add\":\"Add\",\"added_to_pad\":\"Added to #{padNumber}\",\"sound_name_label\":\"Sound Name\",\"sound_name_placeholder\":\"Enter sound name\",\"panel_title\":\"Editing\",\"panel_subtitle\":\"Pad #{padNumber}\",\"custom_generation\":\"Custom generation\",\"loop_on\":\"Loop on\",\"loop_off\":\"Loop off\"},\"volume\":\"Volume\",\"display\":{\"preset\":\"Preset\",\"click_pad_to_play\":\"Click a pad to play\",\"click_pad_to_loop\":\"Click a pad to loop\",\"click_pad_to_edit\":\"Click a pad to edit\",\"looping\":\"Looping\",\"looping_count\":\"{count} looping\",\"unsaved\":\"Unsaved\",\"clear_all_sounds\":\"Clear queue\"},\"add_row_button\":{\"label\":\"Add Row\"},\"button_grid\":{\"empty_button_label\":\"Empty\"},\"edit_mode_button\":{\"label\":\"Edit mode\"},\"loop_button\":{\"label\":\"Loop\",\"unloop\":\"Unloop\"},\"panel\":{\"close\":\"Close panel\"},\"new_preset_button\":{\"label\":\"New Preset\"},\"reset_button\":{\"label\":\"Reset\",\"success\":\"Preset was reset successfully\"},\"download_preset_button\":{\"label\":\"Download all sounds\",\"loading\":\"Preparing download...\",\"success\":\"Download started!\",\"error\":\"Failed to download samples\",\"signup_title\":\"Sign up to download samples\",\"signup_description\":\"Sign up for a free ElevenLabs account to download all samples\",\"signup_button\":\"Create account\"},\"preset_category_selector\":{\"defaults\":\"Defaults\",\"own\":\"My presets\"},\"create_account_cta\":{\"description\":\"Create an account to save your preset and share it with others.\",\"label\":\"Sign up\"},\"midi\":{\"unknown_device\":\"Unknown device\",\"unknown_manufacturer\":\"Unknown manufacturer\",\"assign_midi\":\"Assign MIDI\",\"grant_permissions\":\"Grant permissions\",\"no_devices_found\":\"No devices found\",\"clear\":\"Clear\",\"listening\":\"Listening...\",\"configure_mapping\":\"Configure mapping\",\"none\":\"None\",\"mapped_to\":\"Mapped to {noteName}\"}},\"ElevenStudios\":{\"of_global_population\":\"Of Global Population\"},\"VoiceCloning\":{\"description\":\"Create a replica of your voice that sounds just like you.\",\"widget\":{\"clone\":\"Clone\",\"original\":\"Original\",\"voice_clone\":\"Voice clone\",\"clone_label\":\"Preview Clone\",\"original_label\":\"Preview Original\"}},\"VoiceCloningV2\":{\"tab_examples\":\"Examples\",\"tab_clone_your_voice\":\"Clone your voice\",\"default_header_title\":\"Clone your voice\",\"default_header_description\":\"Try Instant voice cloning to replicate your voice in seconds\",\"upload_a_recording\":\"Upload a recording\",\"record_your_voice\":\"Record your voice\",\"recording_instructions\":\"Record at least 10 seconds of audio without background noise, or 30 seconds for ideal cloning quality.\",\"upload_instructions\":\"Upload a recording with clear audio or record it now. The recording should be 10-30 seconds long for ideal cloning.\",\"recording\":\"Recording\",\"your_recording\":\"Original voice\",\"finish_cloning_voice\":\"Finish cloning voice\",\"login_to_start\":\"Subscribe to clone voice\",\"signup_cta\":\"Sign up for free to use your voice in voiceovers, audiobooks, and effortless script-to-audio creation.\",\"error_file_generic\":\"\\\"{fileName}\\\" could not be processed. Please try another file.\",\"error_file_invalid_type\":\"\\\"{fileName}\\\" is not supported. Please choose an audio file.\",\"error_file_too_large\":\"\\\"{fileName}\\\" exceeds the {maxSize}MB size limit.\",\"generate_coming_soon_title\":\"Generate voice clone\",\"generate_coming_soon_description\":\"This feature will be implemented soon.\",\"upload_error_title\":\"Upload failed\",\"upload_error_description\":\"Something went wrong while uploading your recording. Please try again.\",\"recording_too_short\":\"At least {minSeconds} seconds of audio are required to clone your voice\",\"aria_restart\":\"Restart\",\"nudge_cta\":\"Clone your voice for free in seconds • Trusted by 1M+ creators\",\"nudge_cta_short\":\"Try free • Trusted by 1M+ creators\"},\"VoiceChangerV2\":{\"tab_examples\":\"Examples\",\"tab_change_your_voice\":\"Change your voice\",\"default_header_title\":\"Change your voice\",\"default_header_description\":\"Try Voice Changer to transform your voice in seconds\",\"upload_a_recording\":\"Upload a recording\",\"record_your_voice\":\"Record your voice\",\"recording_instructions\":\"Record at least 10 seconds of audio without background noise, or 30 seconds for ideal quality.\",\"upload_instructions\":\"Upload a recording with clear audio or recor