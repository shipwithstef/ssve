    <script>
      const themeSetting = JSON.parse(localStorage.getItem("studio_theme") ?? '"system"');
      const preference = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      const theme = themeSetting === "system" ? preference : themeSetting;
      document.documentElement.setAttribute("data-theme", theme);

      const isIOSDevice =
        /iPad|iPhone|iPod/.test(navigator.platform) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

      const setMobileShellHeight = () => {
        if (!isIOSDevice) {
          return;
        }

        const shellHeight = Math.max(window.outerHeight, window.innerHeight);
        document.documentElement.style.setProperty("--mobile-shell-height", shellHeight + "px");
      };

      setMobileShellHeight();
      window.addEventListener("load", setMobileShellHeight, { once: true });
    </script>

    <style>
      html[data-theme="dark"] {
        background-color: var(--colors-\$background-secondary, #1d1f20);
      }
      html[data-theme="light"] {
        background-color: var(--colors-\$background-secondary, #ffffff);
      }
    </style>
